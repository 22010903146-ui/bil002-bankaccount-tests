<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BIL002 concurrent deposit and ledger" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Variables" enabled="true">
        <collectionProp name="Arguments.arguments" />
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTPS defaults" enabled="true">
        <stringProp name="HTTPSampler.domain">lab.mykucukkara.com</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <stringProp name="HTTPSampler.port">443</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">20000</stringProp>
      </ConfigTestElement>
      <hashTree />
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON headers" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="Content-Type" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="Accept" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="User-Agent" elementType="Header">
            <stringProp name="Header.name">User-Agent</stringProp>
            <stringProp name="Header.value">Mozilla/5.0 BIL002-Lab</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree />
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Fresh isolated account" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Require private instance path" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
def prefix=props.getProperty('basePath','')
if(!prefix.startsWith('/s/') || prefix.contains('REPLACE') || prefix.contains('&lt;') || prefix.size()&lt;4) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage('Set -JbasePath to your own running instance path')
    ctx.getEngine().stopTest(true)
    return
}
props.put('okDeposits',new java.util.concurrent.atomic.AtomicLong(0))
props.put('uncertainDeposits',new java.util.concurrent.atomic.AtomicLong(0))
</stringProp>
        </JSR223Sampler>
        <hashTree />
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="setup-create" enabled="true">
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <stringProp name="HTTPSampler.path">${__P(basePath)}/api/accounts</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"ownerName": "BIL002-load", "accountType": "STANDARD", "initialBalance": 0}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Keep fresh account" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
if(prev.getResponseCode()!='201') {
    prev.setSuccessful(false)
    ctx.getEngine().stopTest(true)
    return
}
def body=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if(!body.accountNumber || body.balance!=0 || body.status!='ACTIVE') {
    prev.setSuccessful(false)
    ctx.getEngine().stopTest(true)
    return
}
props.setProperty('loadAccount',body.accountNumber.toString())
</stringProp>
          </JSR223PostProcessor>
          <hashTree />
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Concurrent deposits and reads" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,50)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">5</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="deposit" enabled="true">
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <stringProp name="HTTPSampler.path">${__P(basePath)}/api/accounts/${__P(loadAccount)}/deposit</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"amount":1.0}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Count acknowledged deposits" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
if(prev.getResponseCode()=='200') {
    props.get('okDeposits').incrementAndGet()
} else {
    prev.setSuccessful(false)
    // Transport errors and 5xx can leave commit status unknown; do not infer a race from them.
    if(!(prev.getResponseCode() in ['400','404','409','422'])) {
        props.get('uncertainDeposits').incrementAndGet()
    }
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree />
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="balance" enabled="true">
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <stringProp name="HTTPSampler.path">${__P(basePath)}/api/accounts/${__P(loadAccount)}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Balance response is valid" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
try {
    def body=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if(prev.getResponseCode()!='200' || !(body.balance instanceof Number) || body.balance&lt;0) {
        AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Invalid balance response')
    }
} catch(Exception ignored) { AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Invalid JSON') }
</stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Small pacing delay" enabled="true">
          <stringProp name="ConstantTimer.delay">100</stringProp>
        </ConstantTimer>
        <hashTree />
      </hashTree>
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="Final consistency check" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </PostThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="final-ledger" enabled="true">
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <stringProp name="HTTPSampler.path">${__P(basePath)}/api/accounts/${__P(loadAccount)}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Compare final balance with acknowledged total" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
def acknowledged=props.get('okDeposits').get()
def uncertain=props.get('uncertainDeposits').get()
def result=[acknowledgedDeposits:acknowledged,uncertainDeposits:uncertain,
    expectedBalance:acknowledged,actualBalance:null,status:'INCONCLUSIVE']
try {
    def body=new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if(prev.getResponseCode()!='200' || !(body.balance instanceof Number) || acknowledged==0) {
        AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Final check unavailable / no successful deposits')
    } else {
        result.actualBalance=body.balance
        if(uncertain==0) {
            result.status=(body.balance.toBigDecimal()-acknowledged).abs()&lt;=0.001 ? 'PASS' : 'FAIL'
            if(result.status=='FAIL') {
                AssertionResult.setFailure(true);AssertionResult.setFailureMessage('G-5: acknowledged deposits disagree with final balance')
            }
        }
    }
} catch(Exception ignored) { AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Final JSON unavailable') }
def out=new File(props.getProperty('ledgerFile','performans/sonuclar/ledger.json'))
out.parentFile?.mkdirs()
out.text=groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(result))
</stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>